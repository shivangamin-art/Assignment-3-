<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>TaskTrackr - Edit Task</title>

  <!-- bootstrap CSS -->
  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    rel="stylesheet"
  >
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body class="bg-light">
  <!-- navbar -->
  <nav class="navbar navbar-dark bg-dark mb-4">
    <div class="container d-flex justify-content-between align-items-center">
      <a class="navbar-brand" href="/">TaskTrackr</a>
      <a class="nav-link text-light" href="/todos">All Tasks</a>
      <a class="nav-link text-light" href="/lists">Lists</a>
    </div>
  </nav>

  <main class="container py-4">
    <!-- page title -->
    <h2 class="mb-4">Edit Task</h2>

    <!--
      form for updating existing task details
    -->
    <form action="/todos/<%= todo._id %>?_method=PUT" method="POST" class="row g-3">
      
      <div class="col-12">
        <label class="form-label">Title</label>
        <input
          type="text"
          name="title"
          class="form-control"
          value="<%= todo.title %>"
          required
        >
      </div>

      <!-- description page -->
      <div class="col-12">
        <label class="form-label">Description</label>
        <textarea
          name="description"
          class="form-control"
          rows="3"
        ><%= todo.description || '' %></textarea>
      </div>

      <!-- due date -->
      <div class="col-md-4">
        <label class="form-label">Due Date</label>
        <input
          type="date"
          name="dueDate"
          class="form-control"
          value="<%= todo.dueDate ? todo.dueDate.toISOString().substring(0,10) : '' %>"
        >
      </div>

      <!-- priority selectoion dropdown -->
      <div class="col-md-4">
        <label class="form-label">Priority</label>
        <select name="priority" class="form-select">
          <option <%= todo.priority === 'Low' ? 'selected' : '' %>>Low</option>
          <option <%= todo.priority === 'Medium' ? 'selected' : '' %>>Medium</option>
          <option <%= todo.priority === 'High' ? 'selected' : '' %>>High</option>
        </select>
      </div>

      <!-- assignment to the list dropdown -->
      <div class="col-md-4">
        <label class="form-label">List</label>
        <select name="list" class="form-select">
          <option value="">No list</option>
          <% if (lists && lists.length) { %>
            <% lists.forEach(list => { %>
              <option
                value="<%= list._id %>"
                <%= todo.list && todo.list.toString() === list._id.toString() ? 'selected' : '' %>
              >
                <%= list.name %>
              </option>
            <% }) %>
          <% } %>
        </select>
      </div>

      <!-- completion checkbox -->
      <div class="col-md-4">
        <div class="form-check mt-4">
          <input
            class="form-check-input"
            type="checkbox"
            name="completed"
            id="completed"
            <%= todo.completed ? 'checked' : '' %>
          >
          <label class="form-check-label" for="completed">
            Completed
          </label>
        </div>
      </div>

      <!-- Important checkbox -->
      <div class="col-md-4">
        <div class="form-check mt-4">
          <input
            class="form-check-input"
            type="checkbox"
            name="important"
            id="important"
            <%= todo.important ? 'checked' : '' %>
          >
          <label class="form-check-label" for="important">
            Mark as important
          </label>
        </div>
      </div>

      <!-- Submit / Cancel actions -->
      <div class="col-12">
        <button type="submit" class="btn btn-primary">Save Changes</button>
        <a href="/todos" class="btn btn-secondary">Cancel</a>
      </div>
    </form>
  </main>

  <!-- footer for copyright notice -->
  <footer class="text-center py-3 mt-5 border-top bg-white">
    <small>&copy; <%= new Date().getFullYear() %> TaskTrackr</small>
  </footer>

  <!-- bootstrap JS bundle -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
