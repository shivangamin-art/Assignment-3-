<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>TaskTrackr - Add Task</title>

  <!-- bootstrap CSS and local styles -->
  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    rel="stylesheet"
  />
  <link rel="stylesheet" href="/css/styles.css" />
</head>
<body class="bg-light">
  <!-- navbar -->
  <nav class="navbar navbar-dark bg-dark mb-4">
    <div class="container d-flex justify-content-between align-items-center">
      <a class="navbar-brand" href="/">TaskTrackr</a>
      <a class="nav-link text-light" href="/todos">All Tasks</a>
      <a class="nav-link text-light" href="/lists">Lists</a>
    </div>
  </nav>

  <main class="container py-4">
    <!-- page title -->
    <h2 class="mb-4">Add Task</h2>

    <!--  posts a new task to /todos -->
    <form action="/todos" method="POST" class="row g-3">
      <!-- title: required -->
      <div class="col-12">
        <label class="form-label">Title</label>
        <input type="text" name="title" class="form-control" required />
      </div>

      <!-- description: optional -->
      <div class="col-12">
        <label class="form-label">Description</label>
        <textarea name="description" class="form-control" rows="3"></textarea>
      </div>

      <!-- Due Date: optional,  -->
      <div class="col-md-4">
        <label class="form-label">Due Date</label>
        <input type="date" name="dueDate" class="form-control" />
      </div>

      <!-- Priority: choosing task priority -->
      <div class="col-md-4">
        <label class="form-label">Priority</label>
        <select name="priority" class="form-select">
          <option>Low</option>
          <option selected>Medium</option>
          <option>High</option>
        </select>
      </div>

      <!-- assigning task to a list or leave unassigned -->
      <div class="col-md-4">
        <label class="form-label">List</label>
        <select name="list" class="form-select">
          <option value="">No list</option>
          <% if (lists && lists.length) { %>
            <% lists.forEach(list => { %>
              <option value="<%= list._id %>"><%= list.name %></option>
            <% }) %>
          <% } %>
        </select>
      </div>

      <!-- Important checkbox -->
      <div class="col-12">
        <div class="form-check">
          <input class="form-check-input" type="checkbox" name="important" id="important" />
          <label class="form-check-label" for="important">Mark as important</label>
        </div>
      </div>

      <!-- submit or cancel button -->
      <div class="col-12">
        <button type="submit" class="btn btn-success">Create Task</button>
        <a href="/todos" class="btn btn-secondary">Cancel</a>
      </div>
    </form>
  </main>

  <!-- footer for  copyright note -->
  <footer class="text-center py-3 mt-5 border-top bg-white">
    <small>&copy; <%= new Date().getFullYear() %> TaskTrackr</small>
  </footer>

  <!-- bootstrap JS bundle -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
