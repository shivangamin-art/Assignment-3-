<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>TaskTrackr - New Task</title>

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body class="bg-light">

  <!-- NAVBAR -->
  <nav class="navbar navbar-dark bg-dark mb-4">
    <div class="container d-flex justify-content-between align-items-center">
      <div class="d-flex align-items-center gap-4">
        <a class="navbar-brand" href="/">TaskTrackr</a>
        <a class="nav-link text-light" href="/todos">All Tasks</a>
        <a class="nav-link text-light" href="/lists">Lists</a>
      </div>

      <div>
        <% if (user) { %>
          <span class="navbar-text text-light me-3">
            Hello, <%= user.displayName %>
          </span>
          <a class="btn btn-outline-light btn-sm" href="/auth/logout">Logout</a>
        <% } else { %>
          <a class="btn btn-outline-light btn-sm me-2" href="/auth/google">Login with Google</a>
          <a class="btn btn-outline-light btn-sm" href="/auth/github">Login with GitHub</a>
        <% } %>
      </div>
    </div>
  </nav>

  <main class="container py-4">
    <h2 class="mb-4">New Task</h2>

    <form action="/todos" method="POST" class="card p-4 shadow-sm">

      <div class="mb-3">
        <label class="form-label">Title</label>
        <input name="title" type="text" class="form-control" required>
      </div>

      <div class="mb-3">
        <label class="form-label">Description</label>
        <textarea name="description" class="form-control" rows="3"></textarea>
      </div>

      <div class="row mb-3">
        <div class="col-md-4 mb-3 mb-md-0">
          <label class="form-label">Due Date</label>
          <input name="dueDate" type="date" class="form-control">
        </div>

        <div class="col-md-4 mb-3 mb-md-0">
          <label class="form-label">Priority</label>
          <select name="priority" class="form-select">
            <option value="High">High</option>
            <option value="Medium" selected>Medium</option>
            <option value="Low">Low</option>
          </select>
        </div>

        <div class="col-md-4">
          <label class="form-label">List</label>
          <select name="list" class="form-select">
            <option value="">(No list)</option>
            <% if (lists && lists.length) { %>
              <% lists.forEach(list => { %>
                <option value="<%= list._id %>"><%= list.name %></option>
              <% }) %>
            <% } %>
          </select>
        </div>
      </div>

      <div class="form-check mb-3">
        <input name="important" id="important" type="checkbox" class="form-check-input">
        <label class="form-check-label" for="important">Mark as Important</label>
      </div>

      <div class="d-flex justify-content-between">
        <a href="/todos" class="btn btn-outline-secondary">Cancel</a>
        <button type="submit" class="btn btn-success">Create Task</button>
      </div>

    </form>
  </main>

  <footer class="text-center py-3 mt-5 border-top bg-white">
    <small>&copy; <%= new Date().getFullYear() %> TaskTrackr</small>
  </footer>

</body>
</html>
