<!--
  todos/delete.ejs
  Confirmation page for deleting a task.
  Showing a clear warning, the task title, and buttons for confirmation or cancel.
-->
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>TaskTrackr - Delete Task</title>

  <!-- bootstrap CSS for layout and styling -->
  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    rel="stylesheet"
  >
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body class="bg-light">
  <!-- navbar -->
  <nav class="navbar navbar-dark bg-dark mb-4">
    <div class="container d-flex justify-content-between align-items-center">
      <a class="navbar-brand" href="/">TaskTrackr</a>
      <a class="nav-link text-light" href="/todos">All Tasks</a>
      <a class="nav-link text-light" href="/lists">Lists</a>
    </div>
  </nav>

  <main class="container py-4">
    <!-- confirm before deleting of the selected task -->
    <div class="alert alert-warning mt-4">
      <h4 class="alert-heading">Confirm Delete</h4>
      <p>
        Are you sure you want to delete the task
        "<strong><%= todo.title %></strong>"?
      </p>
      <hr>
      <!-- dending a DELETE request to remove the task -->
      <form action="/todos/<%= todo._id %>?_method=DELETE" method="POST" class="d-inline">
        <button type="submit" class="btn btn-danger">Yes, delete</button>
      </form>
      <!-- canceling and returning to the tasks list without changing anything -->
      <a href="/todos" class="btn btn-secondary ms-2">No, go back</a>
    </div>
  </main>

  <!-- footer for copyright note -->
  <footer class="text-center py-3 mt-5 border-top bg-white">
    <small>&copy; <%= new Date().getFullYear() %> TaskTrackr</small>
  </footer>

  <!-- bootstrap JS bundle -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
