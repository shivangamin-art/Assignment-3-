<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>TaskTrackr - My Tasks</title>

  <!-- Bootstrap CSS -->
  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    rel="stylesheet"
  >
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body class="bg-light">
  <nav class="navbar navbar-dark bg-dark mb-4">
    <div class="container">
      <a class="navbar-brand" href="/">TaskTrackr</a>
      <a class="nav-link text-light" href="/todos">My Tasks</a>
    </div>
  </nav>

  <main class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
      <h2>My Tasks</h2>
      <a href="/todos/new" class="btn btn-success">Add Task</a>
    </div>

    <table class="table table-striped table-hover align-middle">
      <thead>
        <tr>
          <th>Title</th>
          <th>Due Date</th>
          <th>Priority</th>
          <th>Status</th>
          <th style="width: 180px;">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% if (!todos || todos.length === 0) { %>
          <tr>
            <td colspan="5" class="text-center text-muted">
              No tasks yet. Click "Add Task" to create your first one.
            </td>
          </tr>
        <% } else { %>
          <% todos.forEach(todo => { %>
            <tr class="<%= todo.completed ? 'table-success' : '' %>">
              <td><%= todo.title %></td>
              <td><%= todo.dueDate ? todo.dueDate.toDateString() : '-' %></td>
              <td><%= todo.priority %></td>
              <td><%= todo.completed ? 'Done' : 'Pending' %></td>
              <td>
                <a href="/todos/<%= todo._id %>/edit" class="btn btn-sm btn-primary">Edit</a>
                <a href="/todos/<%= todo._id %>/delete" class="btn btn-sm btn-outline-danger">Delete</a>
              </td>
            </tr>
          <% }) %>
        <% } %>
      </tbody>
    </table>
  </main>

  <footer class="text-center py-3 mt-5 border-top bg-white">
    <small>&copy; <%= new Date().getFullYear() %> TaskTrackr</small>
  </footer>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
