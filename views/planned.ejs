<!-- views/planned.ejs -->
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>TaskTrackr - Planned</title>

  <!-- bootstrap CSS -->
  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    rel="stylesheet"
  >
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body class="bg-light">
  <!-- navbar -->
  <nav class="navbar navbar-dark bg-dark mb-4">
    <div class="container d-flex justify-content-between align-items-center">
      <a class="navbar-brand" href="/">TaskTrackr</a>
      <a class="nav-link text-light" href="/todos">All Tasks</a>
      <a class="nav-link text-light" href="/lists">Lists</a>
    </div>
  </nav>

  <main class="container-fluid">
    <div class="row">
      <!-- left sidebar with navigation links and list overview  -->
      <aside class="col-12 col-md-3 col-lg-2 mb-4 border-end bg-white">
        <div class="p-3">
          <h5 class="mb-3">Tasks</h5>
          <ul class="list-group mb-4">
            <a href="/" class="list-group-item list-group-item-action">
              My Day
            </a>
            <a href="/important" class="list-group-item list-group-item-action">
              Important
            </a>
            <a href="/planned" class="list-group-item list-group-item-action active">
              Planned
            </a>
          </ul>

          <h6 class="mb-2">Lists</h6>
          <div class="list-group small mb-2">
            <a href="/lists" class="list-group-item list-group-item-action">
              All Lists
            </a>
            <% if (lists && lists.length) { %>
              <% lists.forEach(list => { %>
                <!-- link to open a specific list -->
                <a
                  href="/lists/<%= list._id %>"
                  class="list-group-item list-group-item-action d-flex justify-content-between align-items-center"
                >
                  <span><%= list.name %></span>
                </a>
              <% }) %>
            <% } else { %>
              <!-- message when no lists exist -->
              <div class="text-muted p-2">
                No lists yet.
              </div>
            <% } %>
          </div>

          <!-- action to create a new list -->
          <a href="/lists/new" class="btn btn-sm btn-outline-primary w-100">
            + New List
          </a>
        </div>
      </aside>

      <!--main content planned task -->
      <section class="col-12 col-md-9 col-lg-10 p-4">
        <!-- header title, description and add-task action -->
        <div class="d-flex flex-wrap justify-content-between align-items-center mb-3">
          <div>
            <h2 class="mb-1">Planned</h2>
            <p class="text-muted mb-0">
              Tasks for the next 7 days
            </p>
          </div>

          <div class="mt-2 mt-md-0">
            <!-- add a new task -->
            <a href="/todos/new" class="btn btn-success">+ Add Task</a>
          </div>
        </div>

        <!-- table card for planned tasks with date range -->
        <div class="card">
          <div class="card-header">
            Planned Tasks ( <%= today.toDateString() %> → <%= endOfRange.toDateString() %> )
          </div>
          <div class="card-body p-0">
            <table class="table mb-0 table-hover align-middle">
              <thead>
                <tr>
                  <th>Title</th>
                  <th>List</th>
                  <th>Due Date</th>
                  <th>Priority</th>
                  <th>Status</th>
                  <th>Important</th>
                  <th style="width: 180px;">Actions</th>
                </tr>
              </thead>
              <tbody>
                <!-- message if no planned tasks -->
                <% if (!plannedTodos || plannedTodos.length === 0) { %>
                  <tr>
                    <td colspan="7" class="text-center text-muted py-4">
                      No tasks planned for the next week.
                    </td>
                  </tr>
                <% } else { %>
                  <!-- rendering each planned task row -->
                  <% plannedTodos.forEach(todo => { %>
                    <tr class="<%= todo.completed ? 'table-success' : '' %>">
                      <td><%= todo.title %></td>
                      <td><%= todo.list ? todo.list.name : '-' %></td>
                      <td><%= todo.dueDate ? todo.dueDate.toDateString() : '-' %></td>
                      <td><%= todo.priority %></td>
                      <td><%= todo.completed ? 'Done' : 'Pending' %></td>
                      <td>
                        <% if (todo.important) { %>
                          ⭐
                        <% } else { %>
                          -
                        <% } %>
                      </td>
                      <td>
                        <!-- editing opens the edit form, delete goes to confirmation -->
                        <a href="/todos/<%= todo._id %>/edit" class="btn btn-sm btn-primary">Edit</a>
                        <a href="/todos/<%= todo._id %>/delete" class="btn btn-sm btn-outline-danger">Delete</a>
                      </td>
                    </tr>
                  <% }) %>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </section>
    </div>
  </main>

  <!-- footer for copyright and current year -->
  <footer class="text-center py-3 mt-4 border-top bg-white">
    <small>&copy; <%= new Date().getFullYear() %> TaskTrackr</small>
  </footer>

  <!-- bootstrap JS bundle -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
