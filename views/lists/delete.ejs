<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>TaskTrackr - Delete List</title>

  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    rel="stylesheet"
  >
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body class="bg-light">
  <nav class="navbar navbar-dark bg-dark mb-4">
    <div class="container">
      <a class="navbar-brand" href="/">TaskTrackr</a>
      <a class="nav-link text-light" href="/todos">My Tasks</a>
    </div>
  </nav>

  <main class="container py-4">
    <div class="alert alert-warning mt-4">
      <h4 class="alert-heading">Delete List</h4>
      <p>
        Are you sure you want to delete the list
        "<strong><%= list.name %></strong>"?
      </p>
      <p class="mb-0">
        <strong>All tasks in this list will also be deleted.</strong>
      </p>
      <hr>
      <form action="/lists/<%= list._id %>?_method=DELETE" method="POST" class="d-inline">
        <button type="submit" class="btn btn-danger">Yes, delete list</button>
      </form>
      <a href="/lists" class="btn btn-secondary ms-2">No, go back</a>
    </div>
  </main>

  <footer class="text-center py-3 mt-5 border-top bg-white">
    <small>&copy; <%= new Date().getFullYear() %> TaskTrackr</small>
  </footer>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
