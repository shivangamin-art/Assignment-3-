<!--
  lists/index.ejs
  displaying users with simple actions: open or delete.
-->
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>TaskTrackr - My Lists</title>

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body class="bg-light">

  <!-- navbar:  -->
  <nav class="navbar navbar-dark bg-dark mb-4">
    <div class="container d-flex justify-content-between align-items-center">
      <a class="navbar-brand" href="/">TaskTrackr</a>
      <a class="nav-link text-light" href="/todos">All Tasks</a>
      <a class="nav-link text-light" href="/lists">Lists</a>
    </div>
  </nav>

  <main class="container py-4">
    <!-- creating page title and action for new list  -->
    <div class="d-flex justify-content-between align-items-center mb-4">
      <h2>My Lists</h2>
      <a href="/lists/new" class="btn btn-success">New List</a>
    </div>

    <!-- showing name, date creation and actions -->
    <table class="table table-striped table-hover align-middle">
      <thead>
        <tr>
          <th>List Name</th>
          <th>Created</th>
          <th style="width: 200px;">Actions</th>
        </tr>
      </thead>
      <tbody>
        <!-- messgae for no available list -->
        <% if (!lists || lists.length === 0) { %>
          <tr>
            <td colspan="3" class="text-center text-muted py-4">
              No lists yet. Click "New List" to create your first list.
            </td>
          </tr>
        <% } else { %>
          <!-- listing row with open and delete actions -->
          <% lists.forEach(list => { %>
            <tr>
              <td><%= list.name %></td>
              <td><%= list.createdAt ? list.createdAt.toDateString() : '-' %></td>
              <td>
                <!-- list for viewing tasks -->
                <a href="/lists/<%= list._id %>" class="btn btn-sm btn-primary">Open</a>
                <!-- confirmation page navigation for delete -->
                <a href="/lists/<%= list._id %>/delete" class="btn btn-sm btn-outline-danger">Delete</a>
              </td>
            </tr>
          <% }) %>
        <% } %>
      </tbody>
    </table>
  </main>

  <!-- footer for copyright -->
  <footer class="text-center py-3 mt-5 border-top bg-white">
    <small>&copy; <%= new Date().getFullYear() %> TaskTrackr</small>
  </footer>

  <!-- bootstrap JS bundle -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
