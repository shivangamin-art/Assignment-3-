<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>TaskTrackr - My Lists</title>

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body class="bg-light">

  <!-- NAVBAR -->
  <nav class="navbar navbar-dark bg-dark mb-4">
    <div class="container d-flex justify-content-between align-items-center">
      <div class="d-flex align-items-center gap-4">
        <a class="navbar-brand" href="/">TaskTrackr</a>
        <a class="nav-link text-light" href="/todos">All Tasks</a>
        <a class="nav-link text-light" href="/lists">Lists</a>
      </div>

      <div>
        <% if (user) { %>
          <span class="navbar-text text-light me-3">
            Hello, <%= user.displayName %>
          </span>
          <a class="btn btn-outline-light btn-sm" href="/auth/logout">Logout</a>
        <% } else { %>
          <a class="btn btn-outline-light btn-sm me-2" href="/auth/google">Login with Google</a>
          <a class="btn btn-outline-light btn-sm" href="/auth/github">Login with GitHub</a>
        <% } %>
      </div>
    </div>
  </nav>

  <main class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
      <h2>My Lists</h2>

      <% if (user) { %>
        <a href="/lists/new" class="btn btn-success">New List</a>
      <% } else { %>
        <a href="/auth/google" class="btn btn-outline-success">Login to create lists</a>
      <% } %>
    </div>

    <table class="table table-striped table-hover align-middle">
      <thead>
        <tr>
          <th>List Name</th>
          <th>Created</th>
          <th style="width: 200px;">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% if (!lists || lists.length === 0) { %>
          <tr>
            <td colspan="3" class="text-center text-muted py-4">
              No lists yet.
            </td>
          </tr>
        <% } else { %>
          <% lists.forEach(list => { %>
            <tr>
              <td><%= list.name %></td>
              <td><%= list.createdAt ? list.createdAt.toDateString() : '-' %></td>
              <td>
                <a href="/lists/<%= list._id %>" class="btn btn-sm btn-primary">Open</a>

                <% if (user) { %>
                  <a href="/lists/<%= list._id %>/delete" class="btn btn-sm btn-outline-danger">Delete</a>
                <% } else { %>
                  <span class="text-muted small">Login to delete</span>
                <% } %>
              </td>
            </tr>
          <% }) %>
        <% } %>
      </tbody>
    </table>
  </main>

  <footer class="text-center py-3 mt-5 border-top bg-white">
    <small>&copy; <%= new Date().getFullYear() %> TaskTrackr</small>
  </footer>

</body>
</html>
