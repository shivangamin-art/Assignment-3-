<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>TaskTrackr - My Day</title>

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body class="bg-light">

  <!-- navbar -->
  <nav class="navbar navbar-dark bg-dark mb-4">
    <div class="container d-flex justify-content-between align-items-center">
      <a class="navbar-brand" href="/">TaskTrackr</a>
      <a class="nav-link text-light" href="/todos">All Tasks</a>
      <a class="nav-link text-light" href="/lists">Lists</a>
    </div>
  </nav>

  <main class="container-fluid">
    <div class="row">

      <!-- sidebar -->
      <aside class="col-12 col-md-3 col-lg-2 mb-4 border-end bg-white">
        <div class="p-3">
          <h5 class="mb-3">Tasks</h5>

          <ul class="list-group mb-4">
            <a href="/" class="list-group-item list-group-item-action active">My Day</a>
            <a href="/important" class="list-group-item list-group-item-action">Important</a>
            <!-- quick filters -->
            <a href="/todos?priority=High" class="list-group-item list-group-item-action">
              High Priority
            </a>
            <a href="/todos?priority=Medium" class="list-group-item list-group-item-action">
              Medium Priority
            </a>
            <a href="/todos?priority=Low" class="list-group-item list-group-item-action">
              Low Priority
            </a>
          </ul>

          <h6 class="mb-2">Lists</h6>

          <div class="list-group small mb-2">
            <a href="/lists" class="list-group-item">All Lists</a>

            <!-- rendering each user list -->
            <% lists.forEach(list => { %>
              <a href="/lists/<%= list._id %>" class="list-group-item">
                <%= list.name %>
              </a>
            <% }) %>
          </div>

          <!-- quick action to create a new list -->
          <a href="/lists/new" class="btn btn-outline-primary btn-sm w-100">+ New List</a>
        </div>
      </aside>

      <!-- main content date controls (previous, today, next) toggle completed tasks visibility -->
      <section class="col-12 col-md-9 col-lg-10 p-4">

        <div class="d-flex flex-wrap justify-content-between align-items-center mb-3">

          <div>
            <h2 class="mb-1">My Day</h2>
            <p class="text-muted"><%= currentDate.toDateString() %></p>
          </div>

          <div class="d-flex gap-2 align-items-center">
            <!-- day navigation -->
            <div class="btn-group">
              <a href="/?date=<%= prevDateStr %>" class="btn btn-outline-secondary">&laquo; Previous day</a>
              <a href="/?date=<%= todayDateStr %>" class="btn btn-outline-secondary">Today</a>
              <a href="/?date=<%= nextDateStr %>" class="btn btn-outline-secondary">Next day &raquo;</a>
            </div>

            <!-- toogling completed tasks -->
            <a
              href="/?date=<%= currentDateStr %><%= showCompleted ? '' : '&showCompleted=true' %>"
              class="btn btn-outline-secondary"
            >
              <%= showCompleted ? 'Hide completed' : 'Show completed' %>
            </a>

            <!-- add task -->
            <a href="/todos/new" class="btn btn-success">+ Add Task</a>
          </div>
        </div>

        <div class="card">
          <div class="card-header">
            Tasks to work on by <strong><%= currentDate.toDateString() %></strong>
          </div>

          <div class="card-body p-0">
            <!-- tasks table: -->
            <table class="table table-hover align-middle mb-0">
              <thead>
                <tr>
                  <th>Title</th>
                  <th>List</th>
                  <th>Priority</th>
                  <th>Status</th>
                  <th>Important</th>
                  <th style="width: 220px;">Actions</th>
                </tr>
              </thead>

              <tbody>
                <% if (todosToday.length === 0) { %>
                  <tr><td colspan="6" class="text-center text-muted py-4">No tasks due on this day.</td></tr>
                <% } %>

                <% todosToday.forEach(todo => { %>
                  <tr class="<%= todo.completed ? 'table-success' : '' %>">
                    <td><%= todo.title %></td>
                    <td><%= todo.list ? todo.list.name : '-' %></td>
                    <td><%= todo.priority %></td>
                    <td><%= todo.completed ? 'Done' : 'Pending' %></td>
                    <td><%= todo.important ? '⭐' : '-' %></td>

                    <td>
                      <!-- complete buttions for pending tasks -->
                      <% if (!todo.completed) { %>
                        <form action="/todos/<%= todo._id %>/complete?_method=PUT" class="d-inline" method="POST">
                          <button class="btn btn-sm btn-success">Complete</button>
                        </form>
                      <% } %>

                      <a href="/todos/<%= todo._id %>/edit" class="btn btn-sm btn-primary">Edit</a>
                      <a href="/todos/<%= todo._id %>/delete" class="btn btn-sm btn-outline-danger">Delete</a>
                    </td>
                  </tr>
                <% }) %>
              </tbody>

            </table>
          </div>
        </div>

      </section>
    </div>
  </main>

  <!-- footer for copyright and current year -->
  <footer class="text-center py-3 mt-4 border-top bg-white">
    <small>&copy; <%= new Date().getFullYear() %> TaskTrackr</small>
  </footer>

</body>
</html>
